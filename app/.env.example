PORT=3000

# Local dev: leave TURSO_* blank and the app uses a plain SQLite file at DB_PATH.
# Production (free hosting): fill in TURSO_DATABASE_URL + TURSO_AUTH_TOKEN — see README.md
# "Deploying for free" section. Same code, same SQL, just swaps where the data lives.
DB_PATH=./data/dashboard.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# OAuth ("Sign in with Google") — see credentials/README.md for how to create these.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Cron expression for the in-process auto-sync. On free hosts that sleep when idle, this
# alone is not reliable — see README.md for the free external-cron workaround.
SYNC_CRON=*/15 * * * *
